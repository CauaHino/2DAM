<suki:SukiWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ControlAlmacen.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:suki="https://github.com/kikipoulet/SukiUI"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:views="clr-namespace:ControlAlmacen.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Width="800" Height="800"
        x:Class="ControlAlmacen.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ControlAlmacen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <suki:SukiSideMenu IsSearchEnabled="True">
        <!-- INICIO -->
        <suki:SukiSideMenu.Items>
            <suki:SukiSideMenuItem Header="Inicio" Classes="Compact" >
                <suki:SukiSideMenuItem.Icon>
                    <avalonia:MaterialIcon Kind="HomeCircle"/>
                </suki:SukiSideMenuItem.Icon>
                <suki:SukiSideMenuItem.PageContent>
                    <views:HomeView/>
                </suki:SukiSideMenuItem.PageContent>
                
                <!-- ALTA COMPONENTES -->
            </suki:SukiSideMenuItem>
            <suki:SukiSideMenuItem Header="Alta componentes" Classes="Compact" >
                <suki:SukiSideMenuItem.Icon>
                    <avalonia:MaterialIcon Kind="AddCircleOutline"/>
                </suki:SukiSideMenuItem.Icon>
                <suki:SukiSideMenuItem.PageContent>
                    <views:AltaComponenteView/>
                </suki:SukiSideMenuItem.PageContent>
            </suki:SukiSideMenuItem>
            
            <!-- CONSULTAS -->
            <suki:SukiSideMenuItem Header="Ver Componentes" Classes="Compact" >
                <suki:SukiSideMenuItem.Icon>
                    <avalonia:MaterialIcon Kind="EyeOutline"/>
                </suki:SukiSideMenuItem.Icon>
                <suki:SukiSideMenuItem.PageContent>
                    <views:ConsultasView/>
                </suki:SukiSideMenuItem.PageContent>
            </suki:SukiSideMenuItem>

            <!-- Other Pages -->

        </suki:SukiSideMenu.Items>


        <suki:SukiSideMenu.HeaderContent>
            <!-- Header Content -->
        </suki:SukiSideMenu.HeaderContent>

        <suki:SukiSideMenu.FooterContent>
            <!-- Footer Content -->
        </suki:SukiSideMenu.FooterContent>
    </suki:SukiSideMenu>
</suki:SukiWindow>
